rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function myProfile() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    // Helper: caller is an APPROVED member. Anyone can create an account, but
    // it starts 'pending' until an officer approves it, and a pending,
    // suspended or declined ('archived') account gets none of the member
    // data below. Profiles from before approvals existed have no status and
    // count as approved. The exists() guard matters during signup: the
    // profile does not exist yet, and get() on a missing document aborts
    // rule evaluation.
    function isMember() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        (!('status' in myProfile()) || myProfile().status == 'active');
    }

    // Helper: caller is an approved officer or advisor.
    function isOfficer() {
      return isMember() && myProfile().role in ['officer', 'advisor'];
    }

    // Helper: caller is an approved advisor. Advisors are the only role that
    // may change someone else's role, so this is deliberately narrower than
    // isOfficer().
    function isAdvisor() {
      return isMember() && myProfile().role == 'advisor';
    }

    function changes(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ── Public-facing content (read by anyone, write by officers only) ──────
    match /announcements/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /events/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /officers/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /gallery/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /resources/{id} {
      allow read: if isMember();
      allow write: if isOfficer();
    }

    match /competition_results/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /opportunities/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    // ── Meetings & attendance ───────────────────────────────────────────────
    match /meetings/{id} {
      allow read: if true;
      allow create, delete: if isOfficer();
      // Approved members may update attendees (check-in), officers anything
      allow update: if isOfficer() ||
        (isMember() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees']));
    }

    // ── Member directory ────────────────────────────────────────────────────
    match /members/{userId} {
      // Approved members see the directory. A pending or declined account
      // can read only its own profile, so the app can show its status.
      allow get: if isMember() || (request.auth != null && request.auth.uid == userId);
      allow list: if isMember();

      // Role changes are an advisor's job, and nobody may change their own.
      // Officers approve and decline accounts (status) but can't touch roles.
      // A member editing their own profile can change neither role nor
      // status, so a pending account can't approve itself, and can't rewrite
      // the account type or parent link officers approved it on.
      allow update: if (
        isAdvisor() && request.auth.uid != userId
      ) || (
        isOfficer() && !changes(['role'])
      ) || (
        request.auth != null && request.auth.uid == userId &&
        !changes(['role', 'status', 'accountType', 'parentOf'])
      );

      // Self-signup. Anyone may create their own profile, but only as a
      // pending, plain member: never pre-approved and never an officer or
      // advisor. A parent account must name the member it is the parent of.
      allow create: if isOfficer() || (
        request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.role == 'member' &&
        request.resource.data.status == 'pending' &&
        (
          request.resource.data.accountType == 'student' ||
          (
            request.resource.data.accountType == 'parent' &&
            request.resource.data.parentOf is string &&
            request.resource.data.parentOf.size() >= 2
          )
        )
      );

      allow delete: if isOfficer();
    }

    // ── Access codes ────────────────────────────────────────────────────────
    // Retired. Sign-up no longer uses codes, but a code is still the password
    // of every member who chose to keep it, so no app user (officer or
    // advisor) may read or change them. They are visible only in the Firebase
    // console, to the project owner.
    match /access_codes/{id} {
      allow read, write: if false;
    }

    // ── Competition interests (any member can submit) ───────────────────────
    match /competition_interests/{id} {
      allow read: if isOfficer();
      allow create: if isMember();
      allow delete: if isOfficer();
    }

    // ── Problem reports ─────────────────────────────────────────────────────
    match /problem_reports/{id} {
      allow read: if isOfficer();
      allow create: if isMember();
      allow update, delete: if isOfficer();
    }

    // ── Teams (members create/join, officers can manage) ────────────────────
    match /teams/{id} {
      allow read: if true;
      allow create: if isMember();
      allow update: if isMember();
      allow delete: if isMember();
    }

    // ── Site settings & competition links ───────────────────────────────────
    match /settings/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    // ── Newsletter subscribers ──────────────────────────────────────────────
    match /subscribers/{id} {
      allow read: if isOfficer();
      allow create: if true;
    }
  }
}
