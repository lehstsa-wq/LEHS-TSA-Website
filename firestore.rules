rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the caller is an authenticated officer or advisor.
    // The exists() guard matters during signup — the member document does not
    // exist yet, and get() on a missing document aborts rule evaluation.
    function isOfficer() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['officer', 'advisor'];
    }

    // Helper: caller is an authenticated advisor. Advisors are the only role
    // that may change someone else's role, so this is deliberately narrower
    // than isOfficer().
    function isAdvisor() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'advisor';
    }

    // Helper: caller is any authenticated member
    function isSignedIn() {
      return request.auth != null;
    }

    // ── Public-facing content (read by anyone, write by officers only) ──────
    match /announcements/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /events/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /officers/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /gallery/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /resources/{id} {
      allow read: if isSignedIn();
      allow write: if isOfficer();
    }

    match /competition_results/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    match /opportunities/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    // ── Meetings & attendance ───────────────────────────────────────────────
    match /meetings/{id} {
      allow read: if true;
      allow create, delete: if isOfficer();
      // Allow any signed-in user to update attendees (check-in), officers can update anything
      allow update: if isOfficer() ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees']));
    }

    // ── Member directory ────────────────────────────────────────────────────
    match /members/{userId} {
      allow read: if isSignedIn();

      // Role changes are an advisor's job, and nobody may change their own.
      // Previously any officer could write any member document including
      // `role`, so an officer could promote themselves to advisor or demote
      // the real one. Barring self-role-changes also stops a lone advisor
      // accidentally demoting themselves and leaving nobody able to promote.
      allow update: if (
        // An advisor may change anyone else's record, role included.
        isAdvisor() && request.auth.uid != userId
      ) || (
        // Officers, and members on their own record, may change anything
        // except the role field.
        isSignedIn() &&
        (isOfficer() || request.auth.uid == userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );

      // A new account writes its own member document during signup, so the
      // role it claims has to be constrained here: 'advisor' can never be
      // self-assigned, and 'officer' only when the access code being redeemed
      // is itself an officer code. The plain member path needs no lookup, so
      // ordinary signup cannot break on a missing access-code document.
      allow create: if isOfficer() || (
        isSignedIn() &&
        request.auth.uid == userId && (
          request.resource.data.role == 'member' ||
          (
            request.resource.data.role == 'officer' &&
            exists(/databases/$(database)/documents/access_codes/$(request.resource.data.memberId)) &&
            get(/databases/$(database)/documents/access_codes/$(request.resource.data.memberId)).data.role == 'officer'
          )
        )
      );

      allow delete: if isOfficer();
    }

    // ── Access codes ────────────────────────────────────────────────────────
    // Signup has to validate a code *before* an account exists, so a single-doc
    // read by exact code is public; listing every code stays officer-only.
    match /access_codes/{id} {
      // A single code may be read by exact id because signup has to validate
      // one before an account exists. That permits checking a code you already
      // know, not discovering codes — enumeration needs `list`.
      allow get: if true;
      // Advisors only. Because a member's password is the access code issued to
      // them, anyone who can list codes can sign in as those members, so this
      // is deliberately narrower than isOfficer().
      allow list: if isAdvisor();
      allow create, delete: if isAdvisor();
      // A brand-new account may claim one unused code for itself, and may only
      // touch the three claim fields.
      allow update: if isAdvisor() || (
        isSignedIn() &&
        resource.data.status == 'unused' &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status', 'assignedTo', 'assignedUid']) &&
        request.resource.data.status == 'used' &&
        request.resource.data.assignedUid == request.auth.uid
      );
    }

    // ── Competition interests (any member can submit) ───────────────────────
    match /competition_interests/{id} {
      allow read: if isOfficer();
      allow create: if isSignedIn();
      allow delete: if isOfficer();
    }

    // ── Problem reports ─────────────────────────────────────────────────────
    match /problem_reports/{id} {
      allow read: if isOfficer();
      allow create: if isSignedIn();
      allow update, delete: if isOfficer();
    }

    // ── Teams (members create/join, officers can manage) ────────────────────
    match /teams/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ── Site settings & competition links ───────────────────────────────────
    match /settings/{id} {
      allow read: if true;
      allow write: if isOfficer();
    }

    // ── Newsletter subscribers ──────────────────────────────────────────────
    match /subscribers/{id} {
      allow read: if isOfficer();
      allow create: if true;
    }
  }
}
